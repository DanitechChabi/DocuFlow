# Dépendances
node_modules/

# Variables d'environnement (CRÉDENTIELS — ne jamais publier)
.env
.env.local
.env.production
.env.*
!.env.example
!.env.desktop

# Builds
dist/
build/

# Fichiers uploadés (données utilisateurs)
backend/uploads/

# Copies imbriquées périmées
backend/docuflow-afgc/
frontend/docuflow-afgc/

# App de bureau (Electron)
desktop/node_modules/
desktop/release/
desktop/build/

# Installateur (artefacts de build — reconstruits à la compilation)
installer/node/
installer/release/
installer/*.exe

# Script contenant un mot de passe en clair
backend/set_admin_password.js

# Clé privée de signature des licences de bureau (Ed25519).
# Elle seule permet d'émettre des licences valides : sa fuite rendrait toute
# l'application gratuite. Vit uniquement dans la variable d'environnement Render
# DESKTOP_LICENSE_PRIVATE_KEY. Seule la clé PUBLIQUE est versionnée
# (backend/src/config/licensePublicKey.js).
license-keys-GENERATED.txt
*.pem
*.key

# Logs
*.log
npm-debug.log*

# Système
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Exploration de la base et scripts de diagnostic jetables
# (requêtes ad hoc écrites pour inspecter Neon — non référencées par le code)
check_*.sql
fix_docs.sql
backend/check_tables.js
backend/list_dbs.js
backend/setup_db_runner.js
.tmp-dryrun/

# Notes de revue de code internes
suivi.md
