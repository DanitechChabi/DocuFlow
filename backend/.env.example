# Variables d'environnement du backend DocuFlow-AFGC
# Copier ce fichier en `.env` pour le développement local.
# En production (Render/Railway/VPS), définir ces variables dans les réglages du service.

# Port d'écoute du serveur (Render/Railway l'injecte automatiquement).
# En local : 30001 car le frontend Vite appelle http://127.0.0.1:30001/api par défaut
PORT=30001

# Connexion PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docuflow_afgc
# SSL : mettre "true" sur les bases hébergées qui l'exigent (Neon, Supabase…).
# En local (PostgreSQL classique) : laisser vide / false.
DB_SSL=false

# Clé secrète JWT (obligatoire — utiliser une valeur longue et aléatoire en production)
JWT_SECRET=change_me_to_a_long_random_secret

# ---------------------------------------------------------------------------
# E-mails transactionnels (Resend API — HTTPS port 443, fonctionne sur Render free)
# Laisser vide = aucun e-mail envoyé (les notifications internes fonctionnent quand même)
#
# 1. Créer un compte sur https://resend.com
# 2. API Keys → Create API Key → copier la clé (re_...)
# 3. Optionnel : ajouter et vérifier votre domaine (Domains) pour pouvoir
#    envoyer depuis votre propre adresse (ex. no-reply@votredomaine.com).
#    Sans domaine vérifié, Resend n'accepte que onboarding@resend.dev,
#    qui n'envoie qu'à l'adresse du compte Resend.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Adresse d'expéditeur (doit être un domaine vérifié sur Resend, PAS un @gmail.com).
# Laisser vide = onboarding@resend.dev (mode test, destinataire limité au compte).
# RESEND_FROM=noreply@votredomaine.com
MAIL_FROM_NAME=DocuFlow
# URL publique de l'application (liens dans les e-mails)
APP_URL=http://localhost:5173
# Mode test (développement) : redirige TOUS les e-mails vers une seule adresse.
# Le vrai destinataire est alors ajouté dans le sujet. Retirer en production.
# MAIL_TEST_TO=monadressedetest@gmail.com

# ---------------------------------------------------------------------------
# Site vitrine (obligatoire dès que PayPal est activé)
#
# LANDING_URL est l'adresse du SITE VITRINE (docuflow-landing), pas celle de
# l'application. C'est la vitrine qui porte /tarifs et /paiement/succes, et c'est
# la page de succès qui déclenche la capture du paiement PayPal.
#
# NE PAS y mettre APP_URL : l'application ne déclare aucune route
# /paiement/succes. L'acheteur approuverait son paiement, atterrirait sur une page
# introuvable, la capture n'aurait jamais lieu — commande approuvée mais non
# encaissée, aucune licence émise, et rien dans les journaux.
#
# Plusieurs adresses séparées par des virgules sont acceptées (prévisualisations
# Vercel) ; la première sert aux retours PayPal, toutes sont autorisées en CORS.
# LANDING_URL=https://docuflow-afgc.com

# ---------------------------------------------------------------------------
# Licences de bureau — signature Ed25519 (SERVEUR DE LICENCE UNIQUEMENT)
#
# Sans cette clé, POST /api/licenses/activate répond 503 SIGNING_UNAVAILABLE :
# aucune licence ne peut être émise, donc aucune vente ne peut aboutir.
#
# À définir UNIQUEMENT sur le serveur qui émet les licences (Render). Les postes
# clients n'en ont pas besoin : ils ne font que VÉRIFIER, avec la clé publique
# versionnée dans src/config/licensePublicKey.js.
#
# Format : PEM PKCS#8 sur une seule ligne, sauts de ligne écrits « \n »
# littéralement, SANS guillemets englobants — Render stocke la valeur telle quelle
# et des guillemets rendent la clé indécodable (DECODER routines::unsupported).
# Génération : node backend/generate_license_keys.js
# DESKTOP_LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# ---------------------------------------------------------------------------
# Encaissement — KkiaPay (Mobile Money, XOF) et PayPal (carte, EUR)
#
# Tant que ces variables sont absentes, GET /api/billing/pricing renvoie
# available:false pour les deux moyens : la page de tarifs affiche « Paiement en
# ligne momentanément indisponible » et aucun encaissement n'est possible.
#
# KkiaPay — https://kkiapay.me → Développeurs → Clés d'API
# KKIAPAY_PUBLIC_KEY=      # clé publique, exposée au navigateur (widget)
# KKIAPAY_PRIVATE_KEY=     # clé privée, vérification serveur des transactions
# KKIAPAY_SECRET=          # secret HMAC de signature des webhooks
# KKIAPAY_SANDBOX=true     # true = bac à sable. Passer à false pour encaisser réellement.
#
# PayPal — https://developer.paypal.com → Apps & Credentials
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=       # identifiant du webhook, requis pour valider ses notifications
# Bac à sable par défaut. En production : https://api-m.paypal.com
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

